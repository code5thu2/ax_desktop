# AIPRO API Configuration
AIPRO_API_KEY=your_aipro_api_key_here
AIPRO_BASE_URL=https://api.aipro.vn/v1

# Models
# Model Nhạc trưởng (Main Orchestrator): Siêu nhanh, quản lý ngữ cảnh & lập kế hoạch
GLM_MODEL_NAME=glm-4-flash

# Model Subagent Trinh sát (Vision Subagent): Nhận diện thị giác, soi tọa độ trên ảnh
QWEN_MODEL_NAME=qwen-vl-plus

# Cửa sổ Edge
EDGE_WINDOW_KEYWORD=Edge
MAX_STEPS=20
