# AIPRO API Credentials (OpenAI compatible)
AIPRO_API_KEY=your_aipro_api_key_here
AIPRO_BASE_URL=https://api.aipro.vn/v1

# Models
# Qwen Vision model on AIPRO
QWEN_MODEL_NAME=qwen-vl-plus

# Edge Window Configuration
# Keyword to find the Microsoft Edge window
EDGE_WINDOW_KEYWORD=Edge

# Agent Settings
MAX_STEPS=20
