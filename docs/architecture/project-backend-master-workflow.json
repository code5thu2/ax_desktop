    { "id": "e_user_scope", "from": "user_skill_cfg", "to": "skill_install", "label": "Select Scope / Toggle", "variant": "emphasis" },
    { "id": "e_poll_catalog", "from": "skill_install", "to": "java_catalog", "label": "Sync Catalog & Updates", "variant": "default" },

    { "id": "e_req_whl", "from": "req_wheels", "to": "nexus_gw", "label": "Fetch wheels bundle", "variant": "emphasis" },
    { "id": "e_gw_nexus", "from": "nexus_gw", "to": "nexus_repo", "label": "Proxy win_amd64 .whl", "variant": "security" },
    { "id": "e_ret_whl", "from": "nexus_gw", "to": "deploy_orch", "label": "Stream wheels ZIP", "variant": "emphasis" },

    { "id": "e_deploy_uv", "from": "deploy_orch", "to": "uv_runtime", "label": "Spawn uv venv & install", "variant": "emphasis" },

    { "id": "e_aipro_tool", "from": "aipro_call", "to": "local_gw", "label": "POST /mcp/tools/:name", "variant": "emphasis" },
    { "id": "e_gw_subproc", "from": "local_gw", "to": "mcp_runner", "label": "JSON-RPC Stdio IPC", "variant": "default" },

    { "id": "e_maint_update", "from": "user_maint", "to": "app_updater", "label": "Check & Apply Update", "variant": "default" },
    { "id": "e_maint_purge", "from": "user_maint", "to": "server_purge", "label": "Admin Server Purge", "variant": "security" },
    { "id": "e_maint_clean", "from": "user_maint", "to": "win32_clean", "label": "Client Uninstall", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Track A: MCP Protocol Studio",
      "items": [
        "Daemon runtime: Each MCP runs as an isolated subprocess with its own .venv",
        "Local HTTP Gateway (:8000) exposes standardized REST & SSE tools for AIPRO",
        "Win32 TerminateProcess cleanly drops file locks during uninstall (prevents OS Error 5)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Track B: Skill Context Marketplace",
      "items": [
        "Scope isolation: Global (~/.aipro/skills/{id}) vs Project (<project>/.aipro/skills/{id})",
        "Configuration sync: Updates disabled_skills in config.json on every toggle",
        "Prompt-first execution: Loads SKILL.md directly into AI Agent context window",
        "Project cloning: Supports replicating skills between project directories with 1 click"
      ]
    },
    {
      "dot": "rose",
      "title": "Enterprise Central Infrastructure",
      "items": [
        "Sonatype Nexus 3 (:8081) proxy caches all binary wheels; client has zero credentials",
        "Desktop App auto-updater checks /api/v1/app/check-update and restarts silently",
        "Central Storage enforces strict Anti-ZipSlip verification and SHA-256 integrity"
      ]
    }
  ]
