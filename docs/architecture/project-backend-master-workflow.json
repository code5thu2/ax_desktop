    { "id": "p_prov", "label": "4. Zero-Config Deploy", "fromCol": 3, "toCol": 3 },
    { "id": "p_exec", "label": "5. MCP & Skill Execution", "fromCol": 4, "toCol": 4, "variant": "emphasis" },
    { "id": "p_maint", "label": "6. Lifecycle & Update", "fromCol": 5, "toCol": 5, "variant": "dashed" }
