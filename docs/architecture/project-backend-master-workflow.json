    { "id": "server_purge", "lane": "lane_backend", "col": 5, "type": "backend", "label": "Server Purge API", "sublabel": "DELETE /packages/{id}", "width": 138 },
    { "id": "win32_clean", "lane": "lane_infra", "col": 5, "type": "security", "label": "Win32 Process Killer", "sublabel": "Kill PID & delete .venv", "tag": "Anti-Lock (OS Err 5)", "width": 138 }
