{
  "name": "mcp-protocol-studio",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "mock": "node mock-server.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:clean": "tauri build && node -e \"const fs=require('fs'); if(fs.existsSync('../target/debug')) fs.rmSync('../target/debug', {recursive:true, force:true}); console.log('[CLEANUP] Cleaned target/debug');\"",
    "build:clean": "npm run build && cargo build --release -p desktop && node -e \"const fs=require('fs'); if(fs.existsSync('../target/debug')) fs.rmSync('../target/debug', {recursive:true, force:true}); console.log('[CLEANUP] Cleaned target/debug');\""
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@primevue/themes": "^4.0.7",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@vueuse/core": "^10.9.0",
    "highlight.js": "^11.9.0",
    "lucide-vue-next": "^0.350.0",
    "markdown-it": "^14.0.0",
    "pinia": "^2.1.7",
    "primeicons": "^7.0.0",
    "primevue": "^4.0.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.18",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.4.0",
    "vue-tsc": "^2.0.6"
  }
}
